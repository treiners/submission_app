# Copy this file to .env and fill in real values. Never commit .env to version control.

# --- Flask ---
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production

# --- Storage backend: local | dropbox | onedrive ---
STORAGE_BACKEND=local

# --- Local storage (used when STORAGE_BACKEND=local, or as automatic fallback) ---
LOCAL_UPLOAD_ROOT=uploads

# --- AMPL analysis ---
# Maximum runtime for each admin-triggered .run file.
AMPL_RUN_TIMEOUT_SECONDS=120
# Python interpreter containing amplpy and the activated AMPL modules/license.
# Example: /opt/homebrew/anaconda3/bin/python
AMPL_PYTHON=
# Optional existing AMPL installation directory. Leave blank when using amplpy modules.
AMPL_PATH=

# --- Dropbox (used when STORAGE_BACKEND=dropbox) ---
# Create an app at https://www.dropbox.com/developers/apps (Scoped access, Full Dropbox or App folder).
# Under Permissions, enable files.content.write. Then generate a refresh token (see README).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT_FOLDER=/Submissions

# --- OneDrive / SharePoint (used when STORAGE_BACKEND=onedrive) ---
# Requires an Azure AD app registration with Files.ReadWrite.All (application permission,
# admin-consented) and a client secret. See README for setup steps.
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_ROOT_FOLDER=/Submissions

# --- Email (Gmail SMTP) ---
# Requires a Gmail account with 2-Step Verification enabled, and an "App Password"
# generated at https://myaccount.google.com/apppasswords (NOT your normal Gmail password).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Assignment Submission System

# --- Admin panel ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
